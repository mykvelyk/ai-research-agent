# Copy to `.env` and fill in secrets. Never commit `.env`.

APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research

# Empty = any Telegram user may use the bot. Comma-separated numeric ids to restrict.
ALLOWED_TELEGRAM_USER_IDS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

TAVILY_API_KEY=
